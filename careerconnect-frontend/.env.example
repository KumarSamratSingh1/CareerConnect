# CareerConnect Frontend Environment Configuration Template
# Copy this file to .env and configure your backend endpoint

# Backend API Base URL (includes /api/v1 prefix)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Google OAuth Client ID for Candidate/Recruiter Google Sign-In (Optional)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
