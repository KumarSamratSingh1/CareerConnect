# CareerConnect Backend Environment Configuration Template
# Copy this file to .env and provide your local credentials

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/careerconnect?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Security Configuration
# Secret must be base64-encoded and at least 256 bits (32+ characters)
JWT_SECRET=MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
JWT_EXPIRATION=86400000

# Initial System Admin Seeder
ADMIN_EMAIL=admin@careerconnect.com
ADMIN_PASSWORD=AdminSecurePassword123!

# Google OAuth2 Client ID (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Resume Intelligence AI (Gemini 3.8-flash)
# Keep disabled (false) by default. Requires explicit candidate consent.
RESUME_AI_ENABLED=false
RESUME_AI_API_KEY=your_gemini_api_key_here

# Server & CORS Configuration
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
